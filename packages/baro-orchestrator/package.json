{
  "name": "@baro/orchestrator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "cli": "tsx scripts/cli.ts",
    "test:billing-e2e": "tsx scripts/test-authoritative-billing-e2e.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run test:fast && npm run test:slow",
    "test:fast": "rstest run --project unit",
    "test:slow": "rstest run --project process --pool.maxWorkers 2",
    "test:changed": "rstest run --changed origin/main",
    "test:related": "rstest run --related",
    "test:watch": "rstest watch --project unit"
  },
  "dependencies": {
    "@baro/memory": "*",
    "@mozaik-ai/core": "4.2.0",
    "cross-spawn": "^7.0.6",
    "openai": "^6.38.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@rstest/core": "^0.12.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
